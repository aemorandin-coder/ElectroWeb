# Variables de ElectroShopVe (C-40). Copia este archivo a .env y completa los valores. Nunca subas el .env.

# --- Imprescindibles ---
DATABASE_URL="postgresql://USUARIO:CLAVE@localhost:5432/electroshop?schema=public"
NEXTAUTH_URL="https://tu-dominio"            # En desarrollo: http://localhost:3000
NEXTAUTH_SECRET=""                            # openssl rand -base64 32
GIFT_CARD_PIN_SECRET=""                       # Protege los PIN de las gift cards (si falta usa NEXTAUTH_SECRET)
APP_URL="https://tu-dominio"                  # Enlaces de los correos
NEXT_PUBLIC_APP_URL="https://tu-dominio"
NEXT_PUBLIC_BASE_URL="https://tu-dominio"

# --- Correo: SMTP o Resend ---
EMAIL_PROVIDER="smtp"                         # smtp | resend
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="Electro Shop"
SMTP_FROM_EMAIL=""
# Solo para un servidor de correo PROPIO con certificado autofirmado (C-160). Por defecto el certificado se verifica.
# SMTP_ALLOW_SELF_SIGNED="true"
RESEND_API_KEY=""
RESEND_TEST_EMAIL=""

# --- Seguridad ---
HCAPTCHA_SECRET=""                            # Captcha del login tras intentos fallidos
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=""
CRON_SECRET=""                                # Autoriza /api/cron/envios (rastreo de ZOOM)

# --- Opcionales ---
GOOGLE_CLIENT_ID=""                           # Entrar con Google (el botón aparece solo con las dos)
GOOGLE_CLIENT_SECRET=""
BDV_API_KEY=""                                # Conciliación de Pago Móvil con el BDV
BDV_TELEFONO_COMERCIO=""
BDV_AMBIENTE="produccion"
ZOOM_API_URL=""                               # Oficinas y rastreo de ZOOM
ZOOM_CODIGO_CLIENTE=""
SADES_API_URL=""                              # Inventario de ElectroCaja/SADES
SADES_API_KEY=""
SADES_WEBHOOK_SECRET=""                       # Firma de los avisos de SADES. Distinto al de cualquier ejemplo
GROQ_API_KEY=""                               # Búsqueda de productos en la web: ordena los datos y redacta la descripción (C-155). Sin ella, la búsqueda usa solo sus reglas
GROQ_MODEL=""                                 # Opcional. Por defecto openai/gpt-oss-120b
NEXT_PUBLIC_GA_ID=""                          # Google Analytics
NEXT_PUBLIC_FB_PIXEL_ID=""                    # Píxel de Meta
CAMPAIGN_DELAY_MS="1500"                      # Pausa entre correos de una campaña

# Carpeta temporal de los respaldos (C-165), si /tmp es chica. Opcional. Debe ser privada del usuario de la tienda
# RESPALDOS_DIR_TEMPORAL="/var/tmp"

# --- Solo desarrollo ---
# ADMIN_DEFAULT_PASSWORD="..."                # Contraseña (12 o más caracteres) del administrador que crea `npm run seed`. El seed no corre con NODE_ENV=production
