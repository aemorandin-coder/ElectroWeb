# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-a/
/.next-b/
# Los builds de prueba de las sesiones de Claude (NEXT_DIST_DIR)
/.next-test/
/.next-prueba/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.backup
*.disabled
*.broken

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# Windows reserved filename
nul

# Database files
prisma/dev.db
prisma/dev.db-journal

# Uploads
public/uploads/
# Agent folders
.agents/
.agent/
.claude/*
# C-289: las skills del equipo sí van al repositorio (las lee cada sesión de Claude, en cada PC)
!.claude/skills/

# Documentos privados (acta, RIF): nunca en git ni en public/ (C-72)
private-uploads/
scripts/e2e/mock/
tools/
