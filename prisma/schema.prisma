generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role      @default(USER)
  sessionVersion Int      @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  // C-140: cada inicio de sesión con nombre (dispositivo, fecha, cierre). Session de arriba es del adaptador de NextAuth y no se usa (JWT)
  sesiones      UserSession[]
  // C-141: verificación en dos pasos del panel (app de códigos)
  segundoFactor SegundoFactor?
  orders        Order[]
  warrantyClaims WarrantyClaim[]
  reviews       Review[]
  addresses     Address[]
  reservations  StockReservation[]
  notifications Notification[]
  notificationPreferences NotificationPreference?
  profile       Profile?
  balance       UserBalance?
  wishlist      Wishlist?
  savedPaymentMethods SavedPaymentMethod[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  discountRequests    DiscountRequest[]
  serviceReviews      ServiceReview[]

  // Courses
  courseCreator       CourseCreator?
  courseEnrollments   CourseEnrollment[]
  courseReviews       CourseReview[]

  // Influencer system
  referredByCode      String?    // Code of the influencer who referred this user
  influencerProfile   Influencer? @relation("InfluencerUser")
  referralConversions ReferralConversion[] @relation("ReferredUser")

  @@map("users")
}

model Profile {
  id                          String   @id @default(cuid())
  userId                      String   @unique
  user                        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userEmail                   String?  @unique
  avatar                      String?
  idNumber                    String?  // Cédula o Pasaporte
  phone                       String?
  whatsapp                    String?
  bio                         String?
  birthdate                   String?
  gender                      String?
  city                        String?
  state                       String?
  country                     String?  @default("Venezuela")
  customerType                String   @default("PERSON") // PERSON or COMPANY
  companyName                 String?
  taxId                       String?
  isBusinessAccount           Boolean  @default(false)
  businessVerified            Boolean  @default(false)
  businessVerificationStatus  String   @default("NONE") // NONE, PENDING, APPROVED, REJECTED
  businessRIF                 String?
  businessConstitutiveAct     String?
  businessRIFDocument         String?
  businessVerificationNotes   String?
  businessVerifiedAt          DateTime?
  /// C-147: domicilio fiscal de la empresa, para la factura a su nombre
  businessFiscalAddress       String?
  savedAddresses              String?  // JSON array of saved addresses
  savedCart                   String?  // JSON string with the cart items
  
  // Session Info
  lastLoginAt                 DateTime?
  lastLoginDevice             String?
  lastLoginIp                 String?
  
  // Privacy Preferences
  allowSurveys                Boolean  @default(true)
  shareAnonymousData          Boolean  @default(false)
  
  // Account Status
  accountStatus               String   @default("ACTIVE") // ACTIVE, DEACTIVATED, PENDING_DELETION
  deactivatedAt               DateTime?
  deletionRequestedAt         DateTime?
  deletionReason              String?
  
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@map("profiles")
}

model UserBalance {
  id          String        @id @default(cuid())
  userId      String        @unique
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance     Decimal       @default(0)
  currency    String        @default("USD")
  totalSpent  Decimal       @default(0)
  totalRecharges Decimal    @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  transactions Transaction[]

  @@map("user_balances")
}

model Transaction {
  id              String      @id @default(cuid())
  balanceId       String
  balance         UserBalance @relation(fields: [balanceId], references: [id], onDelete: Cascade)
  type            String      // DEPOSIT, PURCHASE, REFUND
  status          String      // PENDING, COMPLETED, FAILED, CANCELLED
  amount          Decimal
  currency        String
  description     String?
  reference       String?
  paymentMethod   String?
  companyPaymentMethodId String?
  rejectionReason String?     // Reason for rejection if status is CANCELLED
  metadata        String?     // JSON string
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([balanceId])
  @@map("transactions")
}

model BalanceTermsAcceptance {
  id              String   @id @default(cuid())
  userId          String   @unique
  userName        String
  userEmail       String
  userIdNumber    String?  // Cédula
  userPhone       String?
  userAddress     String?
  ipAddress       String?
  userAgent       String?
  termsVersion    String   @default("1.0")
  signatureData   String?  // Base64 encoded signature image
  acceptedAt      DateTime @default(now())
  documentPath    String?  // Path to generated PDF document

  @@map("balance_terms_acceptances")
}

// ============================================
// DOCUMENTOS LEGALES Y FIRMAS (C-103)
// ============================================
// Cada versión de un documento es una fila: el texto firmado nunca cambia. Una firma guarda la huella del
// texto (SHA-256), la imagen del trazo y el PDF generado en el servidor. Las firmas no se borran: pedir una
// firma nueva la marca como revocada. BalanceTermsAcceptance queda como historial de antes de C-103.

model LegalDocument {
  id          String   @id @default(cuid())
  slug        String   // "terminos-saldo"
  version     Int
  title       String
  content     String   // Texto: "## " títulos, "- " viñetas, "!! " aviso destacado, líneas en blanco entre párrafos
  contentHash String   // SHA-256 de título + contenido
  requiredFor String?  // "RECHARGE": sin la firma vigente no se recarga saldo
  isCurrent   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdById String?

  signatures DocumentSignature[]

  @@unique([slug, version])
  @@index([slug, isCurrent])
  @@map("legal_documents")
}

model DocumentSignature {
  id            String        @id @default(cuid())
  documentId    String
  document      LegalDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  // Sin relación con User a propósito: la constancia se conserva aunque la cuenta cambie o se borre
  userId        String
  userName      String
  userEmail     String
  idNumber      String
  phone         String?
  address       String?
  contentHash   String
  signaturePath String        // private-uploads/signatures/...png
  pdfPath       String        // private-uploads/signatures/...pdf
  pdfHash       String
  ipAddress     String?
  userAgent     String?
  signedAt      DateTime      @default(now())
  revokedAt     DateTime?
  revokedReason String?
  revokedById   String?
  legacyAcceptanceId String?  @unique // Firma pasada desde balance_terms_acceptances

  @@index([userId])
  @@index([documentId, userId])
  @@map("document_signatures")
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  street       String
  city         String
  state        String
  zipCode      String
  country      String
  phone        String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("addresses")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
  SUPPORT
}

model Product {
  id          String   @id @default(cuid())
  name        String
  sku         String   @unique
  slug        String   @unique
  shortCode   String?  @unique
  description String
  priceUSD    Decimal
  priceVES    Decimal?
  stock       Int      @default(0)
  minStock    Int      @default(0)
  images      String   // JSON string of image URLs
  mainImage   String?  // Main product image URL
  features    String?  // JSON string of features
  specs       String?  // JSON string of specifications

  // Product Type: PHYSICAL or DIGITAL
  productType ProductType @default(PHYSICAL)
  
  // Digital Product Fields
  digitalPlatform       String?  // STEAM, PLAYSTATION, XBOX, NINTENDO, ROBLOX, FREEFIRE, etc.
  digitalRegion         String?  // GLOBAL, USA, LATAM, EU, etc.
  deliveryMethod        String?  // INSTANT (code delivered immediately) or MANUAL (admin sends code)
  redemptionInstructions String? // Custom instructions for redeeming the digital code
  // C-60: campo que se le pide al cliente en recargas directas ("Usuario de Roblox", "Correo de la cuenta de PSN")
  accountFieldLabel     String?
  accountFieldHint      String?
  
  // Shipping Fields (for PHYSICAL products only)
  weightKg        Decimal?  @default(0)     // Weight in kilograms
  dimensions      String?                    // JSON: {length, width, height} in cm
  isConsolidable  Boolean   @default(true)  // Can be shipped with other products in same box
  shippingCost    Decimal?  @default(0)     // Fixed shipping cost (for non-consolidable items)
  // C-100: la tienda paga el envío de este producto (y del paquete completo que lo lleve)
  freeShipping    Boolean   @default(false)
  
  // Pricing extras
  compareAtPriceUSD Decimal? // Strike-through price to show a discount
  costPerItem       Decimal? // Internal cost (not shown to customers)

  // Inventory extras
  barcode  String?
  tags     String?  // JSON array of tag strings

  // SEO Fields
  seoTitle       String?
  seoDescription String?
  seoImage       String?

  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])

  brandId     String?
  brand       Brand?   @relation(fields: [brandId], references: [id])

  status      ProductStatus @default(DRAFT)
  isFeatured  Boolean       @default(false)

  // C-119: usados y reacondicionados. Nuevo por defecto; lo demás solo cuando no es nuevo
  condition      ProductCondition  @default(NEW)
  conditionGrade ConditionGrade?
  packaging      ProductPackaging?
  includedItems  String?
  missingItems   String?
  usageHours     Int?
  batteryHealth  Int?
  cosmeticNotes  String?
  testNotes      String?
  /// Garantía de la tienda en días (null = la de su condición, lib/product-condition.ts)
  warrantyDays   Int?
  /// Interno, para reclamos de garantía: nunca sale del servidor (no está en lib/dto/product.ts)
  serialNumber   String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime  @updatedAt

  orderItems    OrderItem[]
  reviews       Review[]
  reservations  StockReservation[]
  wishlistItems WishlistItem[]
  digitalCodes  DigitalCode[]
  digitalVariants DigitalVariant[]

  @@map("products")
}

enum ProductType {
  PHYSICAL
  DIGITAL
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// C-60: montos que se venden de un producto digital ("$25", "800 Robux").
// El costo es el de referencia en el proveedor (Eneba, Coinsbee…): nunca sale del servidor hacia la tienda.
model DigitalVariant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  faceValue  Decimal  // 25, 800
  unit       String   // USD, EUR, ROBUX, VBUCKS, … (lib/digital-catalog.ts)
  label      String   // "$25", "800 Robux"
  costUSD    Decimal  @default(0)
  priceUSD   Decimal
  provider   String?  // ENEBA, COINSBEE, OTRO
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orderItems OrderItem[]

  @@index([productId, isActive])
  @@map("digital_variants")
}

// Digital Codes for products like Steam, PlayStation, Xbox cards
model DigitalCode {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  code        String   // The actual code (encrypted in production)
  status      DigitalCodeStatus @default(AVAILABLE)
  
  // When sold
  orderId     String?
  orderItemId String?
  soldAt      DateTime?
  
  // When redeemed/delivered
  deliveredAt DateTime?
  redeemedAt  DateTime?
  
  // Tracking
  addedBy     String?  // Admin who added this code
  notes       String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
  @@index([status])
  @@map("digital_codes")
}

enum DigitalCodeStatus {
  AVAILABLE    // Ready to be sold
  RESERVED     // Reserved during checkout
  SOLD         // Sold and assigned to an order
  DELIVERED    // Delivered to customer
  EXPIRED      // Code expired
  INVALID      // Code marked as invalid
}

// Gift Card Designs (templates)
model GiftCardDesign {
  id              String   @id @default(cuid())
  name            String   // "Gaming Theme", "Birthday", "Christmas", etc.
  slug            String   @unique
  description     String?
  
  // Visual Design
  backgroundImage String?  // Background image URL
  backgroundColor String?  // Fallback background color
  textColor       String?  // Primary text color
  accentColor     String?  // Accent/highlight color
  pattern         String?  // Pattern type: dots, lines, gradient, etc.
  
  // Design Category
  category        String   @default("GENERAL") // GENERAL, GAMING, BIRTHDAY, CHRISTMAS, VALENTINES, etc.
  
  isActive        Boolean  @default(true)
  isDefault       Boolean  @default(false)
  sortOrder       Int      @default(0)
  
  giftCards       GiftCard[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("gift_card_designs")
}

// Electro Shop Gift Cards
model GiftCard {
  id              String   @id @default(cuid())
  
  // Card Details - Security Enhanced
  // Note: 'code' is kept for backwards compatibility, new cards use codeHash
  code            String   @unique  // Format: ESMC-XXXX-XXXX-XXXX (stored normalized without dashes)
  codeHash        String?           // SHA-256 hash of the code for secure lookup
  codeLast4       String?           // Last 4 characters for UI display
  pin             String?           // Optional PIN (hashed for new cards)
  amountUSD       Decimal           // Original amount
  balanceUSD      Decimal           // Remaining balance
  
  // Status
  status          GiftCardStatus @default(INACTIVE)
  
  // Design
  designId        String?
  design          GiftCardDesign? @relation(fields: [designId], references: [id])
  
  // Purchase Info
  purchasedBy     String?         // User ID who purchased
  purchasedAt     DateTime?
  orderId         String?         // Order where it was purchased
  
  // Recipient Info (if sent as gift)
  recipientEmail  String?
  recipientName   String?
  senderName      String?
  personalMessage String?
  
  // Delivery
  deliveredAt     DateTime?
  emailSentAt     DateTime?
  
  // Activation & Expiration
  activatedAt     DateTime?
  expiresAt       DateTime?
  
  // Usage Tracking
  lastUsedAt      DateTime?
  usageCount      Int      @default(0)
  
  // Redemption (when fully used or redeemed)
  redeemedBy      String?         // User ID who redeemed
  redeemedAt      DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Transaction history
  transactions    GiftCardTransaction[]

  @@index([code])
  @@index([codeHash])
  @@index([status])
  @@index([purchasedBy])
  @@map("gift_cards")
}

enum GiftCardStatus {
  INACTIVE      // Created but not activated
  ACTIVE        // Ready to use
  PARTIALLY_USED // Some balance remaining
  DEPLETED      // Fully used (balance = 0)
  EXPIRED       // Past expiration date
  SUSPENDED     // Temporarily disabled
  CANCELLED     // Cancelled/refunded
}

// Gift Card Transaction History
model GiftCardTransaction {
  id            String   @id @default(cuid())
  giftCardId    String
  giftCard      GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  
  type          String   // PURCHASE, ACTIVATION, USAGE, REFUND, ADJUSTMENT
  amountUSD     Decimal
  balanceBefore Decimal
  balanceAfter  Decimal
  
  // If used for an order
  orderId       String?
  orderNumber   String?
  
  // Who made the transaction
  userId        String?
  userEmail     String?
  
  description   String?
  
  createdAt     DateTime @default(now())

  @@index([giftCardId])
  @@map("gift_card_transactions")
}


model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  icon        String?   // react-icons name e.g. "FiMonitor"
  color       String?   // Tailwind color key e.g. "blue", "purple", "green"
  parentId    String?
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

model Brand {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  logo        String?
  products    Product[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("brands")
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique // Format: ORD-YYYY-XXXX
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])

  // Guest Checkout Info (if userId is null)
  guestName     String?
  guestEmail    String?
  guestPhone    String?

  status        OrderStatus @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod String?

  // Amounts
  subtotalUSD   Decimal
  taxUSD        Decimal
  shippingUSD   Decimal
  totalUSD      Decimal
  discountUSD   Decimal     @default(0)
  // C-132: parte del total pagada con Puntos ES (todo en WALLET; una parte en el pago mixto con Pago Móvil)
  pointsUSD     Decimal     @default(0)
  // C-132: referencia que escribió el cliente en un pago manual (Binance Pay, PayPal, Zelle…), para verificarla
  paymentReference String?

  exchangeRate  Decimal
  totalVES      Decimal
  exchangeRateVES Decimal?
  exchangeRateEUR Decimal?

  // Delivery Method
  deliveryMethod  String?   // SHIPPING (ZOOM/MRW), LOCAL_DELIVERY (Guanare), PICKUP. Antes: HOME_DELIVERY, STORE_PICKUP

  // Shipping Info
  shippingAddress String    // Texto legible del destino (lo arma el servidor)
  shippingCarrier String?   // ZOOM, MRW, TEALCA, DOMESA, OTHER
  trackingNumber  String?
  trackingUrl     String?   // URL de seguimiento del carrier
  shippingNotes   String?   // Notas adicionales de envío (oficina, agencia, etc.)
  estimatedDelivery DateTime? // Fecha estimada de entrega

  // C-100: destino y destinatario que eligió el cliente en el checkout
  shippingMode         String?  // OFFICE (retira en oficina) o DOOR (puerta a puerta)
  shippingPaidBy       String?  // CUSTOMER (cobro a destino) o STORE (envío gratis)
  shippingState        String?
  shippingCity         String?
  courierCityCode      String?  // Código de ciudad de ZOOM
  courierOfficeCode    String?  // Código de oficina ZOOM o agencia MRW
  courierOfficeName    String?
  courierOfficeAddress String?
  recipientName        String?
  recipientIdNumber    String?
  recipientPhone       String?
  trackingCheckedAt    DateTime? // Última consulta del rastreo a la empresa
  shipmentEvents       ShipmentEvent[]

  notes         String?
  adminNotes    String?     // Notas internas del admin

  // C-147: a nombre de quién va la factura, copiado al comprar (null en las órdenes de antes)
  billingType    String?    // PERSON (cédula) o COMPANY (empresa verificada, con RIF)
  billingName    String?
  billingTaxId   String?    // Cédula o RIF
  billingAddress String?    // Domicilio fiscal de la empresa
  // La factura se emite fuera de la web (SADES o el talonario): aquí solo se anota su número
  invoiceNumber  String?
  invoicedAt     DateTime?

  // Status Timestamps
  confirmedAt   DateTime?   // Cuando el admin confirma el pedido
  processingAt  DateTime?   // Cuando comienza a prepararse
  paidAt        DateTime?
  shippedAt     DateTime?
  deliveredAt   DateTime?
  cancelledAt   DateTime?

  items         OrderItem[]
  warrantyClaims WarrantyClaim[]
  promotionRedemptions PromotionRedemption[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("orders")
}

// C-100: historial del envío (lo que dice ZOOM y lo que marca el panel)
model ShipmentEvent {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  source      String   // ZOOM, ADMIN
  statusCode  String?
  description String
  location    String?
  occurredAt  DateTime
  createdAt   DateTime @default(now())

  @@unique([orderId, source, occurredAt, description])
  @@index([orderId, occurredAt])
  @@map("shipment_events")
}

enum OrderStatus {
  PENDING           // Pedido recibido, esperando confirmación
  CONFIRMED         // Confirmado por el admin
  PAID              // Pagado (puede ser antes o después de confirmar)
  PROCESSING        // En preparación
  READY_FOR_PICKUP  // Listo para recoger (si es STORE_PICKUP)
  SHIPPED           // Enviado (con info de guía)
  DELIVERED         // Entregado
  CANCELLED         // Cancelado
  REFUNDED          // Reembolsado
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])

  quantity    Int
  priceUSD    Decimal
  totalUSD    Decimal
  productName String?
  productImage String?
  productSku  String?

  // C-60: variante digital comprada y datos de la compra al proveedor (se compra al confirmarse el pago)
  digitalVariantId    String?
  digitalVariant      DigitalVariant? @relation(fields: [digitalVariantId], references: [id], onDelete: SetNull)
  digitalVariantLabel String?
  digitalAccount      String?
  supplier            String?
  supplierOrderRef    String?
  supplierCostUSD     Decimal?

  // C-119: cómo se vendió (copia): si después se edita el producto, la garantía del cliente no cambia.
  // null = orden de antes de C-119 (todo era nuevo)
  productCondition    ProductCondition?
  conditionGrade      ConditionGrade?
  warrantyDays        Int?
  warrantyClaims      WarrantyClaim[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("order_items")
}

model Review {
  id          String   @id @default(cuid())
  rating      Int
  comment     String?
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  isApproved  Boolean  @default(false)
  // C-124: rechazada por moderación (antes no había forma de distinguirla de una pendiente).
  // Pendiente = !isApproved && rejectedAt == null. Editarla la devuelve a pendiente.
  rejectedAt      DateTime?
  rejectionReason String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("reviews")
}

model CompanySettings {
  id          String   @id @default("default")
  companyName String
  tagline     String?
  rif         String?
  legalName   String?
  foundedYear String?
  description String?
  
  // Branding
  logo        String?
  favicon     String?
  /// C-148b: imagen del sello con la firma, sobre la línea "Por la empresa" de los presupuestos
  quoteStamp  String?
  primaryColor   String?
  secondaryColor String?
  
  // Contact
  phone       String?
  whatsapp    String?
  email       String?
  contactEmail String?
  contactPhone String?
  address     String?
  city        String?
  state       String?
  businessHoursText String?
  
  // Social Media
  instagram   String?
  facebook    String?
  twitter     String?
  youtube     String?
  telegram    String?
  tiktok      String?
  socialMedia String?
  
  // Business Logic
  businessHours String?
  primaryCurrency String @default("USD")
  autoExchangeRates Boolean @default(false)
  exchangeRateVES Decimal?
