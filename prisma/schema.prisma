// ============================================
// OFERTAS Y CUPONES DE LA TIENDA (C-102)
// ============================================
// AUTOMATIC: se aplica sola y la tienda la muestra con precio tachado.
// COUPON: se aplica con un código; si es público, la ficha del producto ofrece "Aplicar cupón".
// Nunca aplican a productos digitales. Si un producto tiene varios descuentos, gana el mayor (no se suman).

enum PromotionKind {
  AUTOMATIC
  COUPON
}

enum PromotionScope {
  ALL
  CATEGORY
  PRODUCT
}

model Promotion {
  id             String         @id @default(cuid())
  name           String         // Nombre interno para el panel
  label          String?        // Texto público corto ("Semana Tech")
  kind           PromotionKind
  code           String?        @unique // Cupones: en mayúsculas
  isPublic       Boolean        @default(false) // Cupón visible en la ficha y el carrito
  percentOff     Int?           // 1 a 90
  amountOffUSD   Decimal?       // Automática: por unidad. Cupón: por compra
  scope          PromotionScope @default(ALL)
  productIds     String[]
  categoryIds    String[]
  minSubtotalUSD Decimal?       // Solo cupones: compra mínima de productos que aplican
  startsAt       DateTime       @default(now())
  endsAt         DateTime?
  maxUses        Int?           // Compras con la promoción, en total
  maxUsesPerUser Int?
  usesCount      Int            @default(0)
  isActive       Boolean        @default(true)
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  redemptions PromotionRedemption[]

  @@index([kind, isActive])
  @@map("promotions")
}

model PromotionRedemption {
  id          String    @id @default(cuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId      String
  amountUSD   Decimal
  createdAt   DateTime  @default(now())

  @@unique([promotionId, orderId])
  @@index([promotionId, userId])
  @@map("promotion_redemptions")
}

// ============================================
// ANALYTICS & REPORTING
// ============================================

model AnalyticsEvent {
  id          String   @id @default(cuid())
  eventType   String   // page_view, click, registration, login, purchase, product_request, security_alert, etc.
  eventCategory String // interaction, conversion, security, system
  eventAction String?  // specific action: button_click, form_submit, failed_login, etc.
  eventLabel  String?  // additional context
  eventValue  Float?   // numeric value if applicable
  
  // Page/Source info
  page        String?  // URL or page name where event occurred
  referrer    String?  // Where the user came from
  
  // User info (optional, for logged-in users)
  userId      String?
  userEmail   String?
  
  // Session/Device info
  sessionId   String?
  deviceType  String?  // desktop, mobile, tablet
  browser     String?
  os          String?
  
  // Location info
  ipAddress   String?
  country     String?
  city        String?
  
  // Security-related
  isSuspicious Boolean @default(false)
  threatLevel  String?  // low, medium, high, critical
  threatDetails String?
  
  // Metadata
  metadata    Json?    // Additional flexible data
  
  createdAt   DateTime @default(now())
  
  @@index([eventType])
  @@index([eventCategory])
  @@index([createdAt])
  @@index([userId])
  @@index([isSuspicious])
  @@map("analytics_events")
}

// Security logs for tracking suspicious activities
model SecurityLog {
  id          String   @id @default(cuid())
  eventType   String   // failed_login, brute_force, sql_injection, xss_attempt, unauthorized_access, etc.
  severity    String   // info, warning, critical
  
  ipAddress   String?
  userAgent   String?
  userId      String?
  userEmail   String?
  
  endpoint    String?  // API endpoint or page
  method      String?  // GET, POST, etc.
  payload     String?  // Sanitized request payload
  
  description String
  blocked     Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  
  @@index([eventType])
  @@index([severity])
  @@index([ipAddress])
  @@index([createdAt])
  @@map("security_logs")
}

// Email Configuration for SMTP providers (GoDaddy, Gmail, etc)
model EmailSettings {
  id                    String   @id @default("default")
  
  // Provider Selection
  provider              String   @default("godaddy") // godaddy, gmail, outlook, custom
  
  // SMTP Configuration
  smtpHost              String?  // e.g., smtpout.secureserver.net for GoDaddy
  smtpPort              Int      @default(465)
  smtpSecure            Boolean  @default(true) // true for SSL/TLS
  smtpUser              String?  // Email address
  smtpPassword          String?  // Encrypted password
  
  // From Details
  fromName              String?  // Display name
  fromEmail             String?  // Sender email
  replyTo               String?  // Reply-to email
  
  // Features Toggle
  notificationsEnabled  Boolean  @default(true)  // Order updates, confirmations
  marketingEnabled      Boolean  @default(false) // Promotional emails
  transactionalEnabled  Boolean  @default(true)  // Password reset, verification
  
  // Status
  isConfigured          Boolean  @default(false)
  lastTestAt            DateTime?
  lastTestStatus        String?  // success, failed
  lastTestError         String?
  
  // Rate Limiting
  dailyLimit            Int      @default(500)  // Daily email limit
  sentToday             Int      @default(0)    // Emails sent today
  lastResetAt           DateTime?
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("email_settings")
}

// ============================================
// PAGO MOVIL - VERIFICACION BDV
// ============================================

// Registro de verificaciones de Pago Móvil con la API del BDV
model PagoMovilVerificacion {
  id                  String   @id @default(cuid())
  userId              String
  
  // Datos del pago enviados para verificación
  telefonoPagador     String
  bancoOrigen         String   // Código del banco (4 dígitos)
  referencia          String
  fechaPago           DateTime
  importeSolicitado   Decimal
  
  // Resultado de la verificación
  importeVerificado   Decimal? // Monto devuelto por la API (si fue exitoso)
  // C-125: tasa Bs/USD con la que se cotizó este pago (la de la cotización firmada del checkout o la del momento).
  // Lo pagado se pasa a USD con esta tasa, no con la del día en que se crea la orden o se acredita
  tasaVES             Decimal?
  codigoRespuesta     Int
  mensajeRespuesta    String
  verificado          Boolean  @default(false)
  
  // Contexto de la verificación
  contexto            String   @default("GENERAL") // RECHARGE, ORDER, GENERAL
  transactionId       String?  // Referencia a Transaction (recarga)
  orderId             String?  // Referencia a Order (compra)
  // C-123: pago de compra sin orden que ya se atendió fuera del sistema (orden a mano, producto entregado).
  // Archivado: no se lista, no se acredita y no sirve para otra orden
  archivadoEn         DateTime?
  archivadoPor        String?
  archivadoNota       String?
  
  // Datos raw de respuesta
  rawResponse         String?  // JSON de la respuesta completa
  
  createdAt           DateTime @default(now())
  
  @@index([userId])
  @@index([referencia])
  @@index([verificado])
  @@index([contexto])
  // TODO: Aplicar en próxima migración planificada
  // @@unique([referencia, verificado]) // SEGURIDAD: Prevenir race condition
  @@map("pago_movil_verificaciones")
}

// Audit Log for admin actions and security events
model AuditLog {
  id          String   @id @default(cuid())
  action      String   // Type of action performed
  userId      String?  // User who performed the action
  userEmail   String?  // Email for quick reference
  targetType  String?  // Type of entity affected (USER, PRODUCT, ORDER, etc.)
  targetId    String?  // ID of the affected entity
  details     String?  // JSON with additional details
  ipAddress   String?  // Client IP address
  userAgent   String?  // Client user agent
  severity    String   @default("INFO") // INFO, WARNING, CRITICAL
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([targetType])
  @@index([severity])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// INFLUENCER / REFERRAL SYSTEM
// ============================================

model Influencer {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation("InfluencerUser", fields: [userId], references: [id], onDelete: Cascade)

  code           String   @unique  // e.g. "GAMER2024" — used in ?ref=GAMER2024
  name           String            // Display name (can differ from user.name)
  commissionRate Decimal  @default(5) // Percentage: 5 = 5%
  status         String   @default("ACTIVE") // ACTIVE | PAUSED

  notes          String?           // Internal admin notes

  conversions    ReferralConversion[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([code])
  @@index([status])
  @@map("influencers")
}

model ReferralConversion {
  id             String   @id @default(cuid())
  influencerId   String
  influencer     Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  referredUserId String
  referredUser   User     @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)

  type           String   // REGISTRATION | PURCHASE | RECHARGE
  grossAmount    Decimal  @default(0) // Amount of the order/recharge
  commission     Decimal  @default(0) // Calculated commission (grossAmount × rate / 100)

  // Status flow: PENDING → APPROVED (balance credited) | REJECTED
  status         String   @default("PENDING") // PENDING | APPROVED | REJECTED

  orderId        String?  // Reference to order if type=PURCHASE
  transactionId  String?  // Reference to transaction if type=RECHARGE

  approvedAt     DateTime?
  createdAt      DateTime @default(now())

  @@index([influencerId])
  @@index([referredUserId])
  @@index([status])
  @@index([type])
  @@map("referral_conversions")
}

// C-75: campañas de correo de Marketing. Solo van a clientes que aceptaron promociones,
// un correo por persona con enlace de baja; los destinatarios quedan guardados para reanudar un envío.
model EmailCampaign {
  id              String    @id @default(cuid())
  subject         String
  preheader       String?
  content         String    // JSON con los bloques: título, texto, imagen y botón
  status          String    @default("DRAFT") // DRAFT | SENDING | PAUSED | SENT
  totalRecipients Int       @default(0)
  sentCount       Int       @default(0)
  failedCount     Int       @default(0)
  lastError       String?
  createdById     String?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  recipients      EmailCampaignRecipient[]

  @@index([status])
  @@map("email_campaigns")
}

model EmailCampaignRecipient {
  id          String        @id @default(cuid())
  campaignId  String
  campaign    EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId      String
  email       String
  status      String        @default("PENDING") // PENDING | SENT | FAILED
  error       String?
  sentAt      DateTime?

  @@unique([campaignId, userId])
  @@index([campaignId, status])
  @@map("email_campaign_recipients")
}

// C-112: ElectroStudio, las historias y posts de Marketing. El contenido va en `data` (JSON validado con zod en
// lib/studio/schema.ts); nombre, fecha y lote quedan en columnas para listar y agrupar sin leer el JSON.
model StudioFlyer {
  id          String   @id @default(cuid())
  name        String
  template    String   // solo | duo | trio | mensaje
  data        Json
  date        String?  // AAAA-MM-DD en que se piensa publicar
  batch       String?  // lote ("Componentes PC") para descargar juntos
  code        String?  @unique // C-113: marca de campaña del enlace y el QR (?es=código) para medir visitas y compras
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([updatedAt])
  @@map("studio_flyers")
}

// C-112: ajustes de marca de ElectroStudio (colores, envíos, logos de pago). Una sola fila: id "default".
model StudioBrand {
  id        String   @id @default("default")
  data      Json
  updatedAt DateTime @updatedAt

  @@map("studio_brand")
}

// C-119: productos usados y reacondicionados
enum ProductCondition {
  NEW
  OPEN_BOX
  REFURBISHED
  USED
}

enum ConditionGrade {
  EXCELLENT
  VERY_GOOD
  GOOD
}

enum ProductPackaging {
  ORIGINAL
  GENERIC
  NONE
}

// C-122: solicitudes de garantía con estados e historial (antes, un mensaje más en Mensajes y Solicitudes)
enum WarrantyClaimStatus {
  RECEIVED
  IN_REVIEW
  WAITING_CUSTOMER
  APPROVED
  RESOLVED
  REJECTED
}

/// Cómo se resolvió: la tienda repara; si no puede, cambia; si tampoco, devuelve al saldo (términos 3.0, §6)
enum WarrantyResolution {
  REPAIR
  REPLACEMENT
  BALANCE_REFUND
}

enum WarrantyEventKind {
  CREATED
  STATUS
  MESSAGE
  NOTE
}

model WarrantyClaim {
  id          String    @id @default(cuid())
  /// Número para hablar con el cliente: "G-0012"
  number      Int       @unique @default(autoincrement())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id])
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  /// Clave de WARRANTY_REASONS (lib/product-condition.ts)
  reason        String
  description   String
  status        WarrantyClaimStatus @default(RECEIVED)
  resolution    WarrantyResolution?
  /// true si lo último lo hizo el cliente (crear o responder): el contador del menú del admin
  awaitingStaff Boolean             @default(true)
  /// Resuelta con devolución al saldo: cuánto y con qué movimiento (una sola vez)
  refundUSD           Decimal?
  refundTransactionId String?       @unique

  // Copia al pedirla: el plazo y el producto no cambian si después se edita algo
  productName      String
  productCondition ProductCondition?
  warrantyDays     Int
  deliveredAt      DateTime

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  events WarrantyClaimEvent[]

  @@index([userId])
  @@index([status])
  @@index([orderItemId])
  @@map("warranty_claims")
}

/// Historial: lo que ve el cliente (CREATED, STATUS, MESSAGE) y las notas internas del equipo (NOTE)
model WarrantyClaimEvent {
  id         String               @id @default(cuid())
  claimId    String
  claim      WarrantyClaim        @relation(fields: [claimId], references: [id], onDelete: Cascade)
  kind       WarrantyEventKind
  /// true = lo escribió el cliente; false = el equipo
  byCustomer Boolean
  authorId   String?
  authorName String?
  /// Estado nuevo (en STATUS)
  status     WarrantyClaimStatus?
  message    String?
  /// JSON: enlaces a fotos privadas (/api/uploads/warranty/...)
  photos     String?
  createdAt  DateTime             @default(now())

  @@index([claimId, createdAt])
  @@map("warranty_claim_events")
}
