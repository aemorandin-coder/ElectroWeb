  @@index([userId, createdAt])
  @@map("notifications")
}

// Avisos al equipo (C-73): por qué canal llega cada evento y el bot de Telegram. Una sola fila, id "default".
model AdminNotificationSettings {
  id                        String    @id @default("default")
  // { "ORDER_CREATED": { "panel": true, "email": true, "telegram": true }, ... } — lo que falte usa el valor por defecto del catálogo
  channels                  String?
  // Token del bot cifrado con AES-256-GCM (clave derivada de NEXTAUTH_SECRET). Nunca sale del servidor.
  telegramBotToken          String?
  telegramBotId             String?
  telegramBotUsername       String?
  telegramBotName           String?
  telegramWebhookActive     Boolean   @default(false)
  // Último update_id procesado por getUpdates (cuando no hay webhook)
  telegramUpdateOffset      Int       @default(0)
  // Código para conectar un chat: solo el hash, vence en 15 minutos
  telegramLinkCodeHash      String?
  telegramLinkCodeExpiresAt DateTime?
  telegramLinkCreatedById   String?
  updatedAt                 DateTime  @updatedAt

  @@map("admin_notification_settings")
}

// Chats de Telegram que reciben los avisos: personas o grupos conectados con un código del panel (C-73)
model TelegramChat {
  id          String    @id @default(cuid())
  chatId      String    @unique
  title       String
  type        String    // private | group | supergroup | channel
  isActive    Boolean   @default(true)
  linkedById  String?
  lastSentAt  DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("telegram_chats")
}

// C-140: una fila por inicio de sesión. El JWT lleva su id (`sid`) y el servidor lo revisa en cada petición:
// cerrada, vencida, versión vieja (cerrar todas o las demás) o, en el admin, sin uso por más de 1 hora.
model UserSession {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dispositivo  String    // "Android (Chrome)"
  ip           String?
  metodo       String?   // contraseña | google
  esAdmin      Boolean   @default(false)
  // sessionVersion del usuario con la que vale: "cerrar las demás" sube la del usuario y copia la nueva solo aquí
  version      Int       @default(0)
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  motivoCierre String?   // CERRADA | OTRA_SESION | INACTIVIDAD

  @@index([userId])
  @@map("user_sessions")
}

// C-148: cotizaciones (presupuestos) para empresas e instituciones. El equipo las arma en el panel o el cliente las
// pide desde la tienda; el cliente la abre con un enlace (`token`), la imprime y la aprueba.
model Quote {
  id             String    @id @default(cuid())
  number         String    @unique // PRES-2026-0001
  token          String    @unique // enlace público /cotizacion/<token>
  status         String    @default("DRAFT") // REQUESTED | DRAFT | SENT | APPROVED | REJECTED
  // Cliente
  clientName     String    // empresa o persona
  clientDoc      String?   // RIF o cédula
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  location       String?
  subject        String?   // para qué es ("Equipos para taquilla")
  requestNote    String?   // lo que escribió el cliente al pedirla
  // Condiciones
  validityDays   Int       @default(15)
  advancePercent Int?      // anticipo, si lo hay
  conditions     String?   // condiciones comerciales, una por línea
  terms          String?   // entrega y garantía, una por línea
  // Totales (se recalculan en el servidor cada vez que se guarda)
  totalUSD       Decimal   @default(0)
  taxPercent     Decimal   @default(0) // IVA que ya va dentro de los precios al emitirla (C-146)
  // Seguimiento
  userId         String?   // cuenta del cliente que la pidió, si tenía sesión
  createdById    String?   // quién del equipo la hizo
  sentAt         DateTime?
  approvedAt     DateTime?
  approvedName   String?
  approvedDoc    String?
  approvedIp     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items QuoteItem[]

  @@index([status])
  @@map("quotes")
}

model QuoteItem {
  id           String  @id @default(cuid())
  quoteId      String
  quote        Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId    String? // sin relación: la cotización conserva la línea aunque el producto cambie o se borre
  title        String
  description  String?
  quantity     Int     @default(1)
  unitPriceUSD Decimal
  position     Int     @default(0)
  // C-148b: unidades que se descontaron del inventario al aprobarse la cotización (se devuelven si no se concreta)
  stockDeducted Int    @default(0)
  // …y las que faltaron porque no había (el equipo tiene que conseguirlas antes de entregar)
  stockMissing  Int    @default(0)

  @@index([quoteId])
  @@map("quote_items")
}

// C-141: verificación en dos pasos (TOTP, RFC 6238) de los admin. Obligatoria para usar el panel.
model SegundoFactor {
  userId          String    @id
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secreto         String    // cifrado con AES-256-GCM (lib/dos-pasos.ts); nunca sale del servidor salvo al configurarlo
  activadoAt      DateTime? // null = configuración empezada y sin confirmar
  ultimoPaso      Int       @default(0) // último intervalo de 30 s usado: un código no sirve dos veces
  codigosRespaldo String[]  // HMAC de los códigos de un solo uso que quedan
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("segundo_factor")
}

